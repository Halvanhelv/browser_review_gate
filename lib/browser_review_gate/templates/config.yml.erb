# Settings for browser_review_gate. Every key is optional.
#
# [enforced] settings are checked by the gem: it refuses a report or keeps review on hold.
# [agent] settings are instructions the AI coding agent receives; the gem cannot make a browser
# tool take a screenshot, it can only refuse a run without one when `gate.require_evidence` is on.

# Where the app runs for a browser run. The agent opens `url`; `healthcheck` (a path on `url`, or a
# full URL) is what `verify`, `status` and `doctor` ask to see whether the app answers. Nobody starts
# the app automatically: `start_command` is what the person runs. `sign_in` is a hint such as "use the
# seed account from db/seeds.rb"; never put real credentials here, this file is in the repository.
# A cloud agent cannot reach localhost: give it an environment with a URL it can reach (staging, a
# preview deployment) and select it with `--environment`.
environments:
  local:
    url:<%= url ? " #{url.inspect}" : "" %>
    healthcheck:<%= url ? ' "/up"' : "" %>
    start_command:<%= start_command ? " #{start_command.inspect}" : "" %>
    sign_in:
#  staging:
#    url: "https://staging.example.com"
#    healthcheck: "/up"

verification:
  # The environment used when none is named with --environment.
  environment: local
  # [enforced] A case that passes but reports console errors / failed network requests counts as failed.
  fail_on_console_errors: false
  fail_on_network_errors: false

evidence:
  # [agent] never, on_failure or always. [enforced] with gate.require_evidence, for tools that can.
  screenshots: on_failure
  trace: never
  # [agent] Record console errors and failed requests per case. [enforced] with gate.require_evidence.
  console_logs: true
  network_logs: true
  # [enforced] Saved runs and kept evidence files in the git directory are removed after this many days.
  retention_days: 14
  # [enforced] Hosts that evidence links may point to, e.g. your artifact bucket. Empty: no links.
  link_hosts: []

scenarios:
  # [enforced] The most scenarios the assessing model may ask for (1-30). Mandatory ones come on top.
  max_count: 12
  # [enforced] A passing case from an earlier commit of the PR keeps counting after unrelated commits.
  # false: every scenario must pass on the newest commit.
  reuse_passing: true
  # [enforced] Scenarios added to every assessment that needs a run, whatever the model proposes. With
  # `paths`, only when the change touches them, and then a run is needed whatever the model decides.
  # `matrix: true` repeats the scenario for every combination below (at most 24 cases in total).
  mandatory: []
#    - id: SIGN-IN
#      name: Sign in and land on the dashboard
#      why: Every change to authentication must keep sign-in working.
#      paths: ["app/controllers/sessions_controller.rb", "app/views/sessions/**"]
#      matrix: true
  matrix: {}
#    role: [admin, member]
#    viewport: [desktop, mobile]

gate:
  # [enforced] Refuse runs whose passing cases lack the evidence asked for above.
  require_evidence: false
  # [enforced] Any failing case keeps review on hold, not only failing required scenarios.
  block_on_failure: true

provenance:
  # [enforced] Check each case's Playwright trace against the tested commit. off: no check. warn: the
  # result is shown in the PR. require: a passing case counts only when its trace shows a response
  # from the tested commit (via revision_header), a request to the case's page, and request times
  # inside the run. The app must send the header: add BrowserReviewGate::RevisionHeader to the
  # development middleware. With warn or require the agent is asked for a trace of every case.
  trace: "off"
  revision_header: "X-App-Revision"
  check_pages: true
  clock_skew_seconds: 300

# Who decides what a browser run must cover.
# ci: a model in CI reads each PR, decides whether a run is needed and names the scenarios; the gate
#     checks the published run against that list. Needs one of the secrets below.
# local: no model in CI and no secret. A run is owed whenever a PR touches more than ignore_paths; the
#     author's AI agent chooses the scenarios (plus scenarios.mandatory) and may report that no run is
#     needed, with a reason shown in the PR. A run counts only for the head commit, or for an earlier
#     one when only ignore_paths changed since. Weaker than ci: nobody checks the agent's choice.
assessment: ci

# Who assesses a PR in CI (assessment: ci). Unset: the Claude Code CLI with a CLAUDE_CODE_OAUTH_TOKEN or
# ANTHROPIC_API_KEY secret; with only an OPENAI_API_KEY or GEMINI_API_KEY secret, that provider's API.
# Set `provider` to claude-cli, anthropic, openai or gemini to choose; openai and gemini need `model`.
provider:
model:

# Workflow file name under .github/workflows, used to request an assessment by hand.
workflow: <%= workflow %>

# Someone other than the author may put this label on a PR to let review proceed without a browser
# run, for example when a scenario cannot be exercised locally. Set waiver_by_author to true in a
# repository with a single maintainer.
waiver_label: browser-verification-waived
waiver_by_author: false

# PRs that are never gated.
skip_authors:
  - "dependabot[bot]"
  - "github-actions[bot]"
skip_branch_prefixes: []

# A PR that only touches these paths cannot change browser behavior; no model call is made.
ignore_paths:
  - "docs/**"
  - "test/**"
  - "spec/**"
  - "**/*.md"
  - ".github/**"
